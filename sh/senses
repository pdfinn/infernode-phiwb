#!/dis/sh.dis
# phil/senses [-x] [-m model] [-r a-b] -d document logicfile - whether
# the argument read in logicfile moves between two senses of one word.
# The argument is put afresh to the model at /mnt/llm (/lib/phil/llm),
# with the instructions in /lib/phil/senses: the document's sentences, each
# statement in words (phil/prove -e), and each claim (atom) more than
# one statement uses.  The model answers two questions.  Is each claim
# meant in one sense throughout, or in two, and which statements take
# the second?  And does a premise or assumption take a word from one
# sense to another, joining two claims that use it differently?  It
# does not judge the argument.  The prover does.  A claim in two senses
# is split, a second atom for the second sense in the statements that
# use it; a bridge between senses is taken out (its formula made one
# that is always true); and the argument proved again.  Valid as read
# and not valid after is argue/equivocates, with the case in which it
# fails; still valid is argue/two-senses, a shift the argument does
# not turn on.  The model's answers are kept in logicfile.senses, and a
# split or a taking out that fails in logicfile.senseN.
#
# It is not run by phil/argue: it reads a reading, any reading, as
# phil/prove does.  phil/argue -o x.logic doc; phil/senses -d doc x.logic
load std
run /lib/phil/llm

fn usage {
	echo 'usage: phil/senses [-x] [-m model] [-r a-b] -d document logicfile' >[1=2]
	raise fail:usage
}

x=()
m=()
r=()
doc=()
args=$*
while {~ ${hd $args} -*} {
	opt=${hd $args}
	args=${tl $args}
	if {~ $opt -x} {
		x=-x
	} {~ $opt -m -r -d} {
		if {~ $#args 0} {usage}
		if {~ $opt -m} {
			m=(-m ${hd $args})
		} {~ $opt -r} {
			r=(-r ${hd $args})
		} {
			doc=${hd $args}
		}
		args=${tl $args}
	} {
		usage
	}
}
if {! ~ $#args 1 || ~ $#doc 0} {usage}
logic=${hd $args}

# an atom's name in a formula: a word of lower-case letters, digits and
# _, renamed whole
ren='function ren(s, a, b,   o, t) {
	o = ""
	while(match(s, /[a-z_][a-z0-9_]*/)){
		t = substr(s, RSTART, RLENGTH)
		if(t == a)
			t = b
		o = o substr(s, 1, RSTART-1) t
		s = substr(s, RSTART+RLENGTH)
	}
	return o s
}
function has(s, a) {
	return ren(s, a, "") != s
}'

# the claims more than one statement uses: atom, what it stands for,
# and the statements, a line each
awk -F '	' $ren^'
	$1 == "atom" { n = $2; sub(/\(.*/, "", n); at[++na] = n; mean[n] = $3; next }
	$1 ~ /^[PACOR][0-9]*$/ { st[++ns] = $1; f[ns] = $3 }
	END {
		for(i = 1; i <= na; i++){
			l = ""
			c = 0
			for(j = 1; j <= ns; j++)
				if(has(f[j], at[i])){
					l = l "	" st[j]
					c++
				}
			if(c >= 2)
				print at[i] "	" mean[at[i]] l
		}
	}' $logic > $logic^.shared

# what each statement says, in words
# (awk, not sed: this sed breaks on some lines of logic's symbols)
phil/prove -e $logic $doc >[2=1] | awk '{
	i = index($0, "argue/says: ")
	if(!i)
		next
	r = substr($0, i+12)
	n = r
	sub(/[ :].*/, "", n)
	sub(/: reads /, ": ", r)
	print n "	" r
}' > $logic^.words
if {! ftest -s $logic^.words} {
	rm -f $logic^.shared $logic^.words
	exit
}
llmopen $m
cat /lib/phil/senses > $session/system
{
	echo 'The sentences, numbered:'
	echo
	wwb/sentences -m -t $r $doc
	echo
	echo 'The argument as it was read, statement by statement:'
	echo
	awk -F '	' '{ print "  " $2 }' $logic^.words
	echo
	echo 'The claims the argument uses in more than one statement, each with'
	echo 'the statements that use it:'
	if {! ftest -s $logic^.shared} {
		echo
		echo '(none)'
	}
	awk -F '	' -v 'wf='^$logic^.words 'FILENAME == wf { w[$1] = $2; next }
		{
			print ""
			print "Claim " $1 ": " $2
			for(i = 3; i <= NF; i++){
				if(w[$i] != "")
					print "  " w[$i]
				else
					print "  " $i
			}
		}' $logic^.words $logic^.shared
} > $session/ask
cat $session/ask > $logic^.senses.new
# who answered, by what instructions, when: as a reading says it
who=`{llmname}
how=`{llmsettings}
echo close > $session/ctl
hash=`{sha1sum /lib/phil/senses}
hash=`{echo ${hd $hash} | sed 's/^(............).*/\1/'}
day=`{date | awk 'BEGIN { split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", mn, " "); for(i = 1; i <= 12; i++) mi[mn[i]] = sprintf("%02d", i) } { printf "%s-%s-%02d\n", $NF, mi[$2], $3 }'}
{
	echo '# answered model='^${quote $"who} $"how 'prompt=/lib/phil/senses prompthash='^$hash 'date='^$day
	cat $logic^.senses.new
} > $logic^.senses
rm -f $logic^.senses.new

valid='/argue\/valid -?[0-9]+$/ { v = $NF } END { print v }'
v0=`{phil/prove $logic $doc >[2=1] | awk $valid}
ifs='
'
n=0
for l in `{grep '^[a-z_][a-z0-9_]*	two	' $logic^.senses} {
	n=`{echo $n + 1 | calc}
	echo $l > $logic^.ans
	# the claim split: a second atom for the second sense, in the
	# statements the answer names; none of them, or every statement
	# that uses the claim, is no split
	ok=`{awk -F '	' -v 'OFS=	' -v 'out='^$logic^.split $ren^'
		NR == FNR { a = $1; k = split($4, s, " "); for(i = 1; i <= k; i++) two[s[i]] = 1; sense = $6; next }
		$1 == "atom" {
			nm = $2
			b = nm
			sub(/\(.*/, "", b)
			print > out
			if(b == a){
				# print x > f is a comparison to this awk: print $0
				$0 = "atom" OFS a "_2" substr(nm, length(b)+1) OFS sense
				print > out
			}
			next
		}
		$1 ~ /^[PACOR][0-9]*$/ && has($3, a) {
			uses++
			if(two[$1]){
				$3 = ren($3, a, a "_2")
				moved++
			}
		}
		{ print > out }
		END { print (moved > 0 && moved < uses) ? "split" : "none" }' $logic^.ans $logic}
	if {~ $ok split} {
		phil/prove $logic^.split $doc > $logic^.splitout >[2=1]
		v1=`{awk $valid $logic^.splitout}
		# (an unset variable is 0 to this awk, not "")
		fails=`{awk 'BEGIN { f = "" } /argue\/invalid: [^ ]+ \(S[0-9]+\)/ { if(!got){ i = index($0, "argue/invalid: "); r = substr($0, i+15); j = index(r, ")"); f = substr(r, 1, j); got = 1 } } END { print f }' $logic^.splitout}
		eq=()
		if {~ $v0 1 && ~ $v1 0} {
			eq=1
			cp $logic^.split $logic^.sense^$n
		}
		awk -F '	' -v 'v0='^$"v0 -v 'v1='^$"v1 -v 'eq='^$"eq -v 'fails='^$"fails -v 'logic='^$logic -v 'kept='^$logic^.sense^$n '
			NR == FNR { a = $1; word = $3; list = $4; k = split($4, two, " "); s1 = $5; s2 = $6; next }
			$1 ~ /^[PACOR][0-9]*$/ { sent[$1] = $2 }
			END {
				at = two[1]
				if(sent[at] ~ /^S[0-9]+$/)
					at = at " (" sent[at] ")"
				msg = "\"" word "\" is taken as " s2 " in " list " and as " s1 " where " a " is used else, a reader says"
				what = fails
				if(what == "")
					what = "it"
				if(eq == "1")
					print logic ": argue/equivocates: " at ": " msg ": the argument holds only if they are one; taken apart, " what " does not follow (" kept ")"
				else if(v0 == 1 && v1 == 1)
					print logic ": argue/two-senses: " at ": " msg ": the argument does not turn on it"
				else
					print logic ": argue/two-senses: " at ": " msg
			}' $logic^.ans $logic
		if {~ $#eq 1} {
			awk -v 'logic='^$logic '/: argue\/countermodel: / { sub(/^[^ ]*: /, ""); print logic ": " $0 }' $logic^.splitout
		}
	}
	rm -f $logic^.ans $logic^.split $logic^.splitout
}

# a bridge: a premise or assumption that takes a word from one sense to
# another, taken out, its formula made one that holds whatever is so:
# does the argument still hold without it?
for l in `{grep '^bridge	[PA][0-9]+	' $logic^.senses} {
	n=`{echo $n + 1 | calc}
	echo $l > $logic^.ans
	ok=`{awk -F '	' -v 'OFS=	' -v 'out='^$logic^.split '
		NR == FNR { b = $2; next }
		$1 == b {
			$3 = "(" $3 ") | !(" $3 ")"
			found = 1
		}
		{ print > out }
		END { if(found) print "out"; else print "none" }' $logic^.ans $logic}
	if {~ $ok out} {
		phil/prove $logic^.split $doc > $logic^.splitout >[2=1]
		v1=`{awk $valid $logic^.splitout}
		fails=`{awk 'BEGIN { f = "" } /argue\/invalid: [^ ]+ \(S[0-9]+\)/ { if(!got){ i = index($0, "argue/invalid: "); r = substr($0, i+15); j = index(r, ")"); f = substr(r, 1, j); got = 1 } } END { print f }' $logic^.splitout}
		eq=()
		if {~ $v0 1 && ~ $v1 0} {
			eq=1
			cp $logic^.split $logic^.sense^$n
		}
		awk -F '	' -v 'v0='^$"v0 -v 'v1='^$"v1 -v 'eq='^$"eq -v 'fails='^$"fails -v 'logic='^$logic -v 'kept='^$logic^.sense^$n '
			NR == FNR { b = $2; word = $3; s1 = $4; s2 = $5; next }
			$1 == b { sent = $2 }
			END {
				at = b
				if(sent ~ /^S[0-9]+$/)
					at = at " (" sent ")"
				msg = "it takes \"" word "\" from " s1 " to " s2 ", a reader says"
				what = fails
				if(what == "")
					what = "it"
				if(eq == "1")
					print logic ": argue/equivocates: " at ": " msg ": the argument holds only through it; without it, " what " does not follow (" kept ")"
				else if(v0 == 1 && v1 == 1)
					print logic ": argue/two-senses: " at ": " msg ": the argument does not turn on it"
				else
					print logic ": argue/two-senses: " at ": " msg
			}' $logic^.ans $logic
		if {~ $#eq 1} {
			awk -v 'logic='^$logic '/: argue\/countermodel: / { sub(/^[^ ]*: /, ""); print logic ": " $0 }' $logic^.splitout
		}
	}
	rm -f $logic^.ans $logic^.split $logic^.splitout
}
rm -f $logic^.shared $logic^.words
