#!/dis/sh.dis
# read.inferno phildir wwbdir port - phil/read through a real llmsrv
# whose backend is tests/fakellm.py, answering with data/read/replies:
# one reading, three, and a reader whose file the prover never can
# read; run by tests/read_test.sh.
load std

phil=$1
wwb=${hd ${tl $*}}
port=${hd ${tl ${tl $*}}}
bind -a '#I' /net
ndb/cs
run $phil/philns $phil $wwb
llmsrv -b openai -u http://127.0.0.1:^$port^/v1 -M fake-model
cd $phil/tests
rm -rf out/read
mkdir -p out/read
echo 'The server is patched.' > out/read/doc.md
echo 'Is it?' > out/read/question

echo '# one reader'
phil/read -H 'a test' -o out/read/one /lib/phil/argue out/read/question
echo status $status
cat out/read/one

echo '# three readers'
phil/read -k 3 -o out/read/three /lib/phil/argue out/read/question
echo status $status
for f in out/read/three.1 out/read/three.2 out/read/three.3 {
	grep -s '^# read model=fake-model temperature=[^ ]+ maxtokens=8192 thinking=[^ ]+ prompt=/lib/phil/argue prompthash=[0-9a-f]+ date=[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] confined=namespace net=none$' $f && echo $f has its provenance
}

if {ftest -f out/read/three.4} {
	echo a fourth reading
}

echo '# a reader that never writes a file the prover can read'
phil/read -c phil/readable -d out/read/doc.md -o out/read/bad /lib/phil/argue out/read/question
echo status $status
ftest -f out/read/bad && echo the reading is kept

echo '# no model'
unmount /mnt/llm
phil/read -o out/read/none /lib/phil/argue out/read/question >[2=1]
echo status $status
echo halt > /dev/sysctl
